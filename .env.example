# ==============================================================================
# 1. FRONTEND PUBLIC ENVIRONMENT VARIABLES
# (Safe to be injected into client HTML/JS during build)
# ==============================================================================
DOCS_BASE_URL=https://docs.sugandhaenterprises.com

# ==============================================================================
# 2. PRIVATE SECRETS & SERVER CONFIG
# (NEVER expose to client browser; used ONLY by scripts and CI/CD)
# ==============================================================================
# Cloudflare Account & Project
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CF_PAGES_PROJECT=sugandhaenterprises
CF_PAGES_PRODUCTION_URL=https://www.sugandhaenterprises.com
CF_PAGES_DEV_URL=https://dev.sugandhaenterprises.com

# Cloudflare R2 Storage (S3-Compatible API for admin scripts)
R2_BUCKET_NAME=sugandha-enterprises
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_S3_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com
R2_PUBLIC_DOMAIN=https://docs.sugandhaenterprises.com
